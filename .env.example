# Copy this file to .env and fill it in. Never commit .env.

# MongoDB Atlas → Database → Connect → Drivers. Include the database name before the "?", e.g. /driveease?
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/driveease?retryWrites=true&w=majority

# Signs admin sessions. Any long random string: run  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used by `npm run seed` to create or reset the admin login (10+ characters). Remove the password after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
