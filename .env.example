# Copy this file to .env and fill it in. Never commit .env.

# MongoDB Atlas → Database → Connect → Drivers. Include the database name before the "?", e.g. /driveease?
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/driveease?retryWrites=true&w=majority

# Signs admin sessions. Any long random string: run  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used by `npm run seed` to create or reset the admin login (10+ characters). Remove the password after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary dashboard → Settings → API Keys → "API environment variable" (free plan is enough).
# Without it, the admin still works but photos must be pasted as links.
CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# Optional, local only: the API port for `npm run dev` / `npm start` (default 3001). `npm run demo` uses 3002.
# API_PORT=3001

# The WhatsApp Business number is NOT an environment variable: set it in the admin under Site details.
# If it is missing or invalid, every WhatsApp button falls back to the enquiry form, phone and email.

# REQUIRED in production: the site’s public address (canonical links, sitemap, link previews). Never taken from request headers.
# SITE_URL=https://www.example.in
